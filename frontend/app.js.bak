/* ══════════════════════════════════════════════════════
   NextGenAML — Frontend Application
   ══════════════════════════════════════════════════════ */

const API = "";

// ── Utilities ────────────────────────────────────────
async function apiFetch(path, opts = {}) {
  const res = await fetch(API + path, {
    headers: { "Content-Type": "application/json", ...opts.headers },
    ...opts,
  });
  if (!res.ok) {
    const err = await res.json().catch(() => ({ detail: res.statusText }));
    throw new Error(err.detail || res.statusText);
  }
  return res.json();
}

function escapeHtml(str) {
  const div = document.createElement("div");
  div.textContent = String(str ?? "");
  return div.innerHTML;
}

function fmt(n) {
  if (n == null) return "—";
  const num = Number(n);
  if (isNaN(num)) return String(n);
  if (Math.abs(num) >= 1e7) return (num / 1e7).toFixed(2) + " Cr";
  if (Math.abs(num) >= 1e5) return (num / 1e5).toFixed(2) + " L";
  if (Math.abs(num) >= 1e3) return (num / 1e3).toFixed(1) + "K";
  if (Number.isInteger(num)) return num.toLocaleString("en-IN");
  return num.toFixed(2);
}

function risklevelBadge(level) {
  if (!level) return "";
  const cls = level.toLowerCase().replace(/\s+/g, "-");
  return `<span class="badge badge-${cls}">${escapeHtml(level)}</span>`;
}

function riskColor(score) {
  if (score >= 75) return "var(--red)";
  if (score >= 50) return "var(--orange)";
  if (score >= 30) return "var(--yellow)";
  return "var(--green)";
}

function chartOpts(yLabel) {
  return {
    responsive: true,
    maintainAspectRatio: false,
    plugins: {
      legend: {
        labels: { color: "#8492a6", font: { size: 11, family: "Inter" } },
      },
    },
    scales: {
      x: {
        ticks: { color: "#5a6a85", font: { size: 10 } },
        grid: { color: "rgba(30,45,74,0.4)" },
      },
      y: {
        title: { display: !!yLabel, text: yLabel, color: "#8492a6" },
        ticks: { color: "#5a6a85", font: { size: 10 } },
        grid: { color: "rgba(30,45,74,0.4)" },
      },
    },
  };
}

// ── Navigation ───────────────────────────────────────
document.querySelectorAll(".nav-item").forEach((link) => {
  link.addEventListener("click", (e) => {
    e.preventDefault();
    const page = link.dataset.page;
    document
      .querySelectorAll(".nav-item")
      .forEach((l) => l.classList.remove("active"));
    link.classList.add("active");
    document
      .querySelectorAll(".page")
      .forEach((p) => p.classList.remove("active"));
    document.getElementById("page-" + page).classList.add("active");
    document.getElementById("pageTitle").textContent = link
      .querySelector("span")
      .textContent.trim();

    // Close mobile sidebar
    document.getElementById("sidebar").classList.remove("open");

    // Auto-load data
    if (page === "dashboard") loadDashboard();
    if (page === "analytics") loadAnalytics();
    if (page === "accounts") loadAccounts();
    if (page === "patterns") loadPatterns("all");
    if (page === "graph") setTimeout(loadFullGraph, 50);
    if (page === "model") loadModelInfo();
    if (page === "reports") loadReportsList();
    if (page === "upload") loadUploadStatus();
  });
});

// Sidebar toggle
document.getElementById("sidebar-toggle").addEventListener("click", () => {
  document.getElementById("sidebar").classList.toggle("open");
});

// Navigate programmatically
function navigateToPage(page) {
  const link = document.querySelector(`[data-page="${page}"]`);
  if (link) link.click();
}

// ── Clock ────────────────────────────────────────────
function updateClock() {
  const now = new Date();
  document.getElementById("topbar-clock").textContent = now.toLocaleString(
    "en-IN",
    {
      hour: "2-digit",
      minute: "2-digit",
      second: "2-digit",
      day: "2-digit",
      month: "short",
    },
  );
}
setInterval(updateClock, 1000);
updateClock();

// ── Health Check ─────────────────────────────────────
async function checkHealth() {
  try {
    const d = await apiFetch("/health");
    const dot = document.querySelector(".health-dot");
    dot.classList.add("online");
    dot.classList.remove("offline");
    document.getElementById("health-text").textContent =
      `${d.total_accounts} accounts`;
    document.getElementById("topbar-accounts").textContent =
      `${d.total_accounts} accounts · ${d.total_transactions} txns`;
  } catch {
    const dot = document.querySelector(".health-dot");
    dot.classList.add("offline");
    dot.classList.remove("online");
    document.getElementById("health-text").textContent = "Offline";
  }
}
setInterval(checkHealth, 30000);
checkHealth();

// ── Data Loaded Check ────────────────────────────────
async function checkDataLoaded() {
  try {
    const d = await apiFetch("/upload/status");
    if (!d.loaded) {
      document.getElementById("upload-overlay").style.display = "flex";
    } else {
      document.getElementById("upload-overlay").style.display = "none";
      loadDashboard();
    }
  } catch {
    document.getElementById("upload-overlay").style.display = "flex";
  }
}
checkDataLoaded();

// ══════════════════════════════════════════════════════
//  UPLOAD
// ══════════════════════════════════════════════════════
function setupUpload(
  dropZoneId,
  inputId,
  progressId,
  fillId,
  textId,
  onSuccess,
) {
  const zone = document.getElementById(dropZoneId);
  const input = document.getElementById(inputId);

  zone.addEventListener("click", () => input.click());
  zone.addEventListener("dragover", (e) => {
    e.preventDefault();
    zone.classList.add("drag-over");
  });
  zone.addEventListener("dragleave", () => zone.classList.remove("drag-over"));
  zone.addEventListener("drop", (e) => {
    e.preventDefault();
    zone.classList.remove("drag-over");
    if (e.dataTransfer.files.length) uploadFile(e.dataTransfer.files[0]);
  });
  input.addEventListener("change", () => {
    if (input.files.length) uploadFile(input.files[0]);
  });

  async function uploadFile(file) {
    const prog = document.getElementById(progressId);
    const fill = document.getElementById(fillId);
    const text = document.getElementById(textId);
    prog.style.display = "block";
    fill.style.width = "20%";
    text.textContent = "Uploading " + file.name + "…";

    const formData = new FormData();
    formData.append("file", file);

    try {
      fill.style.width = "60%";
      const res = await fetch(API + "/upload/csv", {
        method: "POST",
        body: formData,
      });
      fill.style.width = "90%";
      if (!res.ok) {
        const err = await res.json().catch(() => ({}));
        throw new Error(err.detail || "Upload failed");
      }
      const data = await res.json();
      fill.style.width = "100%";
      text.textContent = `✓ Loaded ${data.rows} transactions, ${data.accounts} accounts`;
      if (onSuccess) onSuccess(data);
    } catch (e) {
      fill.style.width = "0%";
      text.textContent = "✗ " + e.message;
    }
  }
}

setupUpload(
  "overlay-drop-zone",
  "overlay-file-input",
  "overlay-progress",
  "overlay-progress-fill",
  "overlay-progress-text",
  () => {
    document.getElementById("upload-overlay").style.display = "none";
    checkHealth();
    loadDashboard();
  },
);

setupUpload(
  "upload-drop-zone",
  "upload-file-input",
  "upload-progress",
  "upload-progress-fill",
  "upload-progress-text",
  () => {
    checkHealth();
    loadUploadStatus();
  },
);

async function loadUploadStatus() {
  const box = document.getElementById("upload-status");
  try {
    const d = await apiFetch("/upload/status");
    if (!d.loaded) {
      box.innerHTML =
        '<p class="muted">No dataset loaded. Upload a CSV file to begin.</p>';
      return;
    }
    box.innerHTML = `
      <div class="info-grid">
        <div class="info-item"><span class="info-label">Status</span><span class="info-value">${risklevelBadge("Verified")}</span></div>
        <div class="info-item"><span class="info-label">Transactions</span><span class="info-value">${fmt(d.rows)}</span></div>
        <div class="info-item"><span class="info-label">Accounts</span><span class="info-value">${fmt(d.accounts)}</span></div>
        <div class="info-item"><span class="info-label">Edges</span><span class="info-value">${fmt(d.edges)}</span></div>
        ${d.columns ? `<div class="info-item" style="grid-column:1/-1"><span class="info-label">Columns</span><span class="info-value">${d.columns.join(", ")}</span></div>` : ""}
      </div>`;
  } catch (e) {
    box.innerHTML = `<p class="muted" style="color:var(--red)">Error: ${escapeHtml(e.message)}</p>`;
  }
}

// ══════════════════════════════════════════════════════
//  DASHBOARD
// ══════════════════════════════════════════════════════
let dashTrendChart = null;

async function loadDashboard() {
  try {
    const d = await apiFetch("/dashboard");
    document.getElementById("kpi-transactions").textContent = fmt(
      d.total_transactions,
    );
    document.getElementById("kpi-volume").textContent =
      "₹" + fmt(d.total_volume);
    document.getElementById("kpi-flagged").textContent =
      "₹" + fmt(d.flagged_amount);
    document.getElementById("kpi-highrisk").textContent = fmt(
      d.high_risk_entities,
    );
    document.getElementById("kpi-active-cases").textContent = fmt(
      d.active_cases,
    );
    document.getElementById("kpi-risk-score").textContent =
      d.system_risk_score != null ? d.system_risk_score.toFixed(1) + "%" : "—";

    // Recent activity
    const box = document.getElementById("recent-activity");
    if (d.recent_activity && d.recent_activity.length) {
      let html =
        "<table><thead><tr><th>Sender</th><th>Receiver</th><th>Amount</th><th>Pattern</th><th>Time</th></tr></thead><tbody>";
      d.recent_activity.forEach((a) => {
        html += `<tr>
          <td>${escapeHtml(a.sender)}</td>
          <td>${escapeHtml(a.receiver)}</td>
          <td>₹${fmt(a.amount)}</td>
          <td><span class="badge badge-flagged">${escapeHtml(a.pattern || "—")}</span></td>
          <td>${escapeHtml(a.timestamp)}</td>
        </tr>`;
      });
      box.innerHTML = html + "</tbody></table>";
    } else {
      box.innerHTML = '<p class="muted">No recent activity.</p>';
    }

    // Trends chart
    if (d.trends && Object.keys(d.trends).length) {
      const labels = Object.keys(d.trends);
      const values = Object.values(d.trends);
      const ctx = document.getElementById("dashTrendChart").getContext("2d");
      if (dashTrendChart) dashTrendChart.destroy();
      dashTrendChart = new Chart(ctx, {
        type: "bar",
        data: {
          labels,
          datasets: [
            {
              label: "Volume (₹)",
              data: values,
              backgroundColor: "rgba(99, 102, 241, 0.5)",
              borderColor: "#6366f1",
              borderWidth: 1,
              borderRadius: 6,
            },
          ],
        },
        options: chartOpts("Volume (₹)"),
      });
    }
  } catch (e) {
    document.getElementById("kpi-transactions").textContent = "Error";
  }
}

// ══════════════════════════════════════════════════════
//  ACCOUNTS
// ══════════════════════════════════════════════════════
async function loadAccounts() {
  const box = document.getElementById("accounts-table");
  box.innerHTML = '<p class="muted">Loading…</p>';
  try {
    const search = document.getElementById("acc-search").value.trim();
    const status = document.getElementById("acc-status-filter").value;
    let url = "/accounts/?limit=50";
    if (search) url += "&search=" + encodeURIComponent(search);
    if (status) url += "&status=" + encodeURIComponent(status);
    const data = await apiFetch(url);
    if (!data.length) {
      box.innerHTML = '<p class="muted">No accounts found.</p>';
      return;
    }
    let html = `<table><thead><tr>
      <th>Account</th><th>Risk Score</th><th>Pattern</th><th>Status</th><th>Volume 30d</th><th>Tx Count</th><th>Actions</th>
    </tr></thead><tbody>`;
    data.forEach((a) => {
      html += `<tr>
        <td><strong>${escapeHtml(a.account_id)}</strong></td>
        <td>
          <div class="risk-meter">
            <span>${a.risk_score.toFixed(1)}</span>
            <div class="risk-bar-bg"><div class="risk-bar-fill" style="width:${a.risk_score}%;background:${riskColor(a.risk_score)}"></div></div>
          </div>
        </td>
        <td>${escapeHtml(a.pattern_detected || "—")}</td>
        <td>${risklevelBadge(a.status)}</td>
        <td>₹${fmt(a.volume_30d)}</td>
        <td>${a.transaction_count}</td>
        <td>
          <button class="btn btn-primary" style="padding:0.25rem 0.5rem;font-size:0.72rem" onclick="quickPredict('${escapeHtml(a.account_id)}')">Predict</button>
          <button class="btn btn-outline" style="padding:0.25rem 0.5rem;font-size:0.72rem" onclick="quickExplain('${escapeHtml(a.account_id)}')">Explain</button>
        </td>
      </tr>`;
    });
    box.innerHTML = html + "</tbody></table>";
  } catch (e) {
    box.innerHTML = `<p class="muted" style="color:var(--red)">Error: ${escapeHtml(e.message)}</p>`;
  }
}

async function quickPredict(accountId) {
  document.getElementById("predict-account-id").value = accountId;
  navigateToPage("predictions");
  singlePredict();
}

async function quickExplain(accountId) {
  navigateToPage("predictions");
  const box = document.getElementById("predict-result");
  box.innerHTML = '<p class="muted">Loading explanation…</p>';
  try {
    const d = await apiFetch("/explain/" + encodeURIComponent(accountId));
    let html = `<div class="detail-box">
      <strong>Account:</strong> ${escapeHtml(d.account_id)}<br>
      <strong>Risk Score:</strong> ${d.risk_score?.toFixed(1)}%<br>
      <strong>Recommendation:</strong> ${escapeHtml(d.recommendation)}<br><br>
      <strong>Risk Factors:</strong><br>`;
    (d.risk_factors || []).forEach((f) => {
      html += `• <strong>${escapeHtml(f.factor || f.name || "")}</strong>: ${escapeHtml(f.description || f.detail || JSON.stringify(f))}<br>`;
    });
    html += "<br><strong>Suspicious Edges:</strong><br>";
    (d.top_suspicious_edges || []).forEach((e) => {
      html += `• ${escapeHtml(e.source || e.from)} → ${escapeHtml(e.target || e.to)}: ₹${fmt(e.amount || e.total_amount)}<br>`;
    });
    html += "</div>";
    box.innerHTML = html;
  } catch (e) {
    box.innerHTML = `<p class="muted" style="color:var(--red)">Error: ${escapeHtml(e.message)}</p>`;
  }
}

// ══════════════════════════════════════════════════════
//  PREDICTIONS
// ══════════════════════════════════════════════════════
async function singlePredict() {
  const accountId = document.getElementById("predict-account-id").value.trim();
  if (!accountId) return;
  const box = document.getElementById("predict-result");
  box.innerHTML = '<p class="muted">Analyzing…</p>';
  try {
    const d = await apiFetch(
      "/predict?account_id=" + encodeURIComponent(accountId),
      { method: "POST" },
    );
    box.innerHTML = `<div class="detail-box">
      <strong>Account:</strong> ${escapeHtml(d.account_id)}<br>
      <strong>Fraud Probability:</strong> <span style="color:${riskColor(d.fraud_probability * 100)}">${(d.fraud_probability * 100).toFixed(2)}%</span><br>
      <strong>Risk Level:</strong> ${risklevelBadge(d.risk_level)}<br>
      <strong>Confidence:</strong> ${(d.confidence * 100).toFixed(1)}%
    </div>`;
  } catch (e) {
    box.innerHTML = `<p class="muted" style="color:var(--red)">Error: ${escapeHtml(e.message)}</p>`;
  }
}

async function batchPredict() {
  const ids = document
    .getElementById("batch-account-ids")
    .value.split(",")
    .map((s) => s.trim())
    .filter(Boolean);
  if (!ids.length) return;
  const box = document.getElementById("batch-result");
  box.innerHTML = '<p class="muted">Processing batch…</p>';
  try {
    const data = await apiFetch("/predict/batch", {
      method: "POST",
      body: JSON.stringify({ account_ids: ids }),
    });
    let html = `<table><thead><tr><th>Account</th><th>Fraud Prob</th><th>Risk Level</th><th>Confidence</th></tr></thead><tbody>`;
    data.forEach((d) => {
      html += `<tr>
        <td>${escapeHtml(d.account_id)}</td>
        <td style="color:${riskColor(d.fraud_probability * 100)}">${(d.fraud_probability * 100).toFixed(2)}%</td>
        <td>${risklevelBadge(d.risk_level)}</td>
        <td>${(d.confidence * 100).toFixed(1)}%</td>
      </tr>`;
    });
    box.innerHTML = html + "</tbody></table>";
  } catch (e) {
    box.innerHTML = `<p class="muted" style="color:var(--red)">Error: ${escapeHtml(e.message)}</p>`;
  }
}

async function monitorTransaction() {
  const sender = document.getElementById("mon-sender").value.trim();
  const receiver = document.getElementById("mon-receiver").value.trim();
  const amount = parseFloat(document.getElementById("mon-amount").value);
  const txType =
    document.getElementById("mon-type").value.trim() || "wire_transfer";
  if (!sender || !receiver || isNaN(amount)) return;

  const box = document.getElementById("monitor-result");
  box.innerHTML = '<p class="muted">Monitoring…</p>';
  try {
    const d = await apiFetch("/monitor/transaction", {
      method: "POST",
      body: JSON.stringify({
        sender_account: sender,
        receiver_account: receiver,
        amount,
        transaction_type: txType,
      }),
    });
    box.innerHTML = `<div class="detail-box">
      <strong>Transaction ID:</strong> ${escapeHtml(d.transaction_id)}<br>
      <strong>Status:</strong> ${risklevelBadge(d.status)}<br>
      <strong>Risk Score:</strong> <span style="color:${riskColor(d.risk_score)}">${d.risk_score?.toFixed(1)}%</span><br>
      <strong>Flags:</strong> ${(d.flags || []).map((f) => escapeHtml(f)).join(", ") || "None"}
    </div>`;
  } catch (e) {
    box.innerHTML = `<p class="muted" style="color:var(--red)">Error: ${escapeHtml(e.message)}</p>`;
  }
}

// ══════════════════════════════════════════════════════
//  ALERTS
// ══════════════════════════════════════════════════════
async function loadAlerts() {
  const minRisk =
    parseInt(document.getElementById("alert-min-risk").value) / 100;
  const limit = parseInt(document.getElementById("alert-limit").value);
  const box = document.getElementById("alerts-table");
  box.innerHTML = '<p class="muted">Generating alerts…</p>';
  try {
    const data = await apiFetch("/alert", {
      method: "POST",
      body: JSON.stringify({ min_risk: minRisk, limit }),
    });
    if (!data.length) {
      box.innerHTML = '<p class="muted">No alerts at this threshold.</p>';
      return;
    }
    let html = `<table><thead><tr><th>Account</th><th>Risk Score</th><th>Pattern</th><th>Status</th><th>Volume</th></tr></thead><tbody>`;
    data.forEach((a) => {
      html += `<tr>
        <td><strong>${escapeHtml(a.account_id)}</strong></td>
        <td>
          <div class="risk-meter">
            <span style="color:${riskColor(a.risk_score)}">${a.risk_score?.toFixed(1)}</span>
            <div class="risk-bar-bg"><div class="risk-bar-fill" style="width:${a.risk_score}%;background:${riskColor(a.risk_score)}"></div></div>
          </div>
        </td>
        <td>${escapeHtml(a.pattern_detected || "—")}</td>
        <td>${risklevelBadge(a.status)}</td>
        <td>₹${fmt(a.volume_30d)}</td>
      </tr>`;
    });
    box.innerHTML = html + "</tbody></table>";
  } catch (e) {
    box.innerHTML = `<p class="muted" style="color:var(--red)">Error: ${escapeHtml(e.message)}</p>`;
  }
}

// ══════════════════════════════════════════════════════
//  PATTERNS
// ══════════════════════════════════════════════════════
async function loadPatterns(type, btnEl) {
  // Update button group active state
  if (btnEl) {
    btnEl
      .closest(".btn-group")
      .querySelectorAll(".btn")
      .forEach((b) => {
        b.classList.remove("btn-primary", "active");
        b.classList.add("btn-outline");
      });
    btnEl.classList.remove("btn-outline");
    btnEl.classList.add("btn-primary", "active");
  }

  // Hide all pattern cards first
  document.getElementById("patterns-circular").style.display = "none";
  document.getElementById("patterns-structuring").style.display = "none";
  document.getElementById("patterns-dormant").style.display = "none";

  try {
    const data = await apiFetch("/patterns/" + type);
    if (type === "all") {
      renderCircular(data.circular || []);
      renderStructuring(data.structuring || []);
      renderDormant(data.dormant || []);
      document.getElementById("patterns-circular").style.display = "";
      document.getElementById("patterns-structuring").style.display = "";
      document.getElementById("patterns-dormant").style.display = "";
    } else if (type === "circular") {
      renderCircular(data);
      document.getElementById("patterns-circular").style.display = "";
    } else if (type === "structuring") {
      renderStructuring(data);
      document.getElementById("patterns-structuring").style.display = "";
    } else if (type === "dormant") {
      renderDormant(data);
      document.getElementById("patterns-dormant").style.display = "";
    }
  } catch (e) {
    alert("Error loading patterns: " + e.message);
  }
}

function renderCircular(arr) {
  const box = document.getElementById("circular-table");
  if (!arr.length) {
    box.innerHTML = '<p class="muted">No circular patterns detected.</p>';
    return;
  }
  let html =
    "<table><thead><tr><th>Cycle</th><th>Length</th><th>Total Flow</th></tr></thead><tbody>";
  arr.forEach((c) => {
    html += `<tr><td>${(c.account_chain || []).map(escapeHtml).join(" → ")}</td><td>${c.cycle_length}</td><td>₹${fmt(c.total_flow)}</td></tr>`;
  });
  box.innerHTML = html + "</tbody></table>";
}

function renderStructuring(arr) {
  const box = document.getElementById("structuring-table");
  if (!arr.length) {
    box.innerHTML = '<p class="muted">No structuring patterns detected.</p>';
    return;
  }
  let html =
    "<table><thead><tr><th>Sender</th><th>Transactions</th><th>Total Amount</th><th>Avg Amount</th><th>Window (min)</th></tr></thead><tbody>";
  arr.forEach((s) => {
    html += `<tr><td>${escapeHtml(s.sender)}</td><td>${s.transactions}</td><td>₹${fmt(s.total_amount)}</td><td>₹${fmt(s.avg_amount)}</td><td>${fmt(s.time_window_minutes)}</td></tr>`;
  });
  box.innerHTML = html + "</tbody></table>";
}

function renderDormant(arr) {
  const box = document.getElementById("dormant-table");
  if (!arr.length) {
    box.innerHTML = '<p class="muted">No dormant activations detected.</p>';
    return;
  }
  let html =
    "<table><thead><tr><th>Account</th><th>Dormant Days</th><th>Activation Amount</th><th>Date</th></tr></thead><tbody>";
  arr.forEach((d) => {
    html += `<tr><td>${escapeHtml(d.account_id)}</td><td>${d.dormant_days}</td><td>₹${fmt(d.activation_amount)}</td><td>${escapeHtml(d.activation_date)}</td></tr>`;
  });
  box.innerHTML = html + "</tbody></table>";
}

// ══════════════════════════════════════════════════════
//  GRAPH EXPLORER
// ══════════════════════════════════════════════════════
let graphSim = null;
let _graphDragCleanup = null;
let _graphState = null; // persisted so filters work without re-fetch
let _graphZoomFns = null; // expose zoom/reset to external buttons

function nodeColor(risk) {
  if (risk >= 75) return "#d63031";
  if (risk >= 50) return "#e17055";
  if (risk >= 25) return "#fdcb6e";
  return "#00b894";
}

function nodeRadius(risk, nodeCount) {
  // Bigger differentiation – high-risk nodes are visually prominent
  const base = nodeCount > 200 ? 4 : nodeCount > 100 ? 6 : 8;
  const scale = nodeCount > 200 ? 10 : nodeCount > 100 ? 14 : 18;
  return base + (risk / 100) * scale;
}

async function loadSubgraph() {
  const id = document.getElementById("graph-account-id").value.trim();
  if (!id) return;
  try {
    const d = await apiFetch("/graph/subgraph/" + encodeURIComponent(id));
    _graphState = {
      nodes: d.nodes || [],
      links: d.links || [],
      centerId: d.center_account,
    };
    renderGraphFiltered();
  } catch (e) {
    alert("Error: " + e.message);
  }
}

async function loadFullGraph() {
  try {
    const limitSel = document.getElementById("graph-limit");
    const limit = limitSel ? +limitSel.value : 100;
    const d = await apiFetch("/graph/full?limit=" + limit);
    if (d.truncated) {
      console.info(
        `Graph truncated: showing ${d.nodes.length} of ${d.total_in_graph} accounts (highest risk)`,
      );
    }
    _graphState = { nodes: d.nodes || [], links: d.links || [] };
    renderGraphFiltered();
  } catch (e) {
    alert("Error loading graph: " + e.message);
  }
}

/* Apply client-side risk filter then render */
function renderGraphFiltered() {
  if (!_graphState) return;
  const minRisk = +(document.getElementById("graph-risk-filter")?.value || 0);
  const filtered = _graphState.nodes.filter(
    (n) => (n.risk ?? n.risk_score ?? 0) >= minRisk,
  );
  const ids = new Set(filtered.map((n) => n.id));
  const filteredLinks = _graphState.links.filter((l) => {
    const s = l.source?.id ?? l.source ?? l.from;
    const t = l.target?.id ?? l.target ?? l.to;
    return ids.has(s) && ids.has(t);
  });
  renderGraph(filtered, filteredLinks, _graphState.centerId);
}

function applyGraphRiskFilter() {
  const v = document.getElementById("graph-risk-filter").value;
  document.getElementById("graph-risk-val").textContent = v + "%";
  renderGraphFiltered();
}

function applyGraphEdgeFilter() {
  if (!_graphState) return;
  const mode = document.getElementById("graph-edge-mode").value;
  const svg = document.getElementById("graph-svg");
  const lines = svg.querySelectorAll("line");
  const annots = svg.querySelectorAll(".edge-annotation");
  lines.forEach((l, i) => {
    const tier = l.dataset.tier;
    let visible;
    if (mode === "none") visible = false;
    else if (mode === "all") visible = true;
    else if (mode === "suspicious")
      visible = tier === "suspicious" || tier === "warning";
    else if (mode === "safe") visible = tier === "safe" || tier === "normal";
    else visible = true;
    l.style.display = visible ? "" : "none";
    if (annots[i]) annots[i].style.display = visible ? "" : "none";
  });
}

function reLayoutGraph() {
  renderGraphFiltered();
}

function toggleGraphAnnotations() {
  renderGraphFiltered();
}

function graphZoom(factor) {
  if (_graphZoomFns) _graphZoomFns.zoom(factor);
}
function graphResetView() {
  if (_graphZoomFns) _graphZoomFns.reset();
}

async function loadGraphStats() {
  const panel = document.getElementById("graph-stats-panel");
  const box = document.getElementById("graph-stats-content");
  panel.style.display = "";
  box.innerHTML = '<p class="muted">Loading…</p>';
  try {
    const d = await apiFetch("/graph/stats");
    box.innerHTML = `
      <div class="info-grid">
        <div class="info-item"><span class="info-label">Total Accounts</span><span class="info-value">${fmt(d.total_accounts)}</span></div>
        <div class="info-item"><span class="info-label">Total Transactions</span><span class="info-value">${fmt(d.total_transactions)}</span></div>
        <div class="info-item"><span class="info-label">Flagged Accounts</span><span class="info-value">${fmt(d.flagged_accounts)}</span></div>
        <div class="info-item"><span class="info-label">Total Volume</span><span class="info-value">₹${fmt(d.total_volume)}</span></div>
        <div class="info-item"><span class="info-label">Avg Transaction</span><span class="info-value">₹${fmt(d.avg_transaction)}</span></div>
        <div class="info-item"><span class="info-label">Suspicious Volume</span><span class="info-value">₹${fmt(d.suspicious_volume)}</span></div>
      </div>`;
  } catch (e) {
    box.innerHTML = `<p class="muted" style="color:var(--red)">Error: ${escapeHtml(e.message)}</p>`;
  }
}

function renderGraph(nodes, links, centerId) {
  // Stop previous simulation & clean up leaked listeners
  if (graphSim) {
    graphSim.stop = true;
    graphSim = null;
  }
  if (_graphDragCleanup) {
    _graphDragCleanup();
    _graphDragCleanup = null;
  }

  const svg = document.getElementById("graph-svg");
  const tooltip = document.getElementById("graph-tooltip");
  svg.innerHTML = "";

  const rect = svg.getBoundingClientRect();
  const W = Math.max(rect.width, 900);
  const H = Math.max(rect.height, 620);
  svg.setAttribute("viewBox", `0 0 ${W} ${H}`);

  // Node count display
  const countEl = document.getElementById("graph-node-count");
  if (countEl)
    countEl.textContent = nodes.length
      ? `${nodes.length} nodes • ${links.length} edges`
      : "";

  if (!nodes.length) {
    svg.innerHTML =
      '<text x="50%" y="50%" text-anchor="middle" fill="#5a6a85" font-size="14">No graph data — click Full Graph or adjust filters</text>';
    return;
  }

  const N = nodes.length;
  const showLabels = N <= 120;

  // Defs: arrow marker + glow filter
  const defs = document.createElementNS("http://www.w3.org/2000/svg", "defs");
  defs.innerHTML = `
    <marker id="arrow" markerWidth="6" markerHeight="5" refX="6" refY="2.5" orient="auto">
      <path d="M0,0 L6,2.5 L0,5 Z" fill="rgba(255,255,255,0.1)"/>
    </marker>
    <marker id="arrow-warn" markerWidth="6" markerHeight="5" refX="6" refY="2.5" orient="auto">
      <path d="M0,0 L6,2.5 L0,5 Z" fill="rgba(251,191,36,0.5)"/>
    </marker>
    <marker id="arrow-sus" markerWidth="6" markerHeight="5" refX="6" refY="2.5" orient="auto">
      <path d="M0,0 L6,2.5 L0,5 Z" fill="rgba(239,68,68,0.5)"/>
    </marker>
    <filter id="glow"><feGaussianBlur stdDeviation="2.5" result="blur"/>
      <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>`;
  svg.appendChild(defs);

  // Choose layout mode
  const layoutMode = document.getElementById("graph-layout")?.value || "force";

  // Index nodes & assign initial positions based on layout
  const nodeMap = {};
  const cx = W / 2,
    cy = H / 2;
  const spread = Math.min(W, H) * 0.42;

  if (layoutMode === "radial") {
    // Sort by risk descending; high-risk in center ring
    const sorted = [...nodes].sort(
      (a, b) => (b.risk ?? b.risk_score ?? 0) - (a.risk ?? a.risk_score ?? 0),
    );
    sorted.forEach((n, i) => {
      const ring = Math.floor(i / Math.max(8, N * 0.15));
      const ringCount = Math.min(
        Math.max(8, N * 0.15),
        N - ring * Math.max(8, N * 0.15),
      );
      const posInRing = i % Math.max(8, Math.ceil(N * 0.15));
      const angle = (posInRing / ringCount) * Math.PI * 2;
      const radius =
        50 + ring * (spread / Math.ceil(N / Math.max(8, N * 0.15)));
      n._x = cx + Math.cos(angle) * radius;
      n._y = cy + Math.sin(angle) * radius;
      n._vx = 0;
      n._vy = 0;
      nodeMap[n.id] = n;
    });
  } else if (layoutMode === "grid") {
    const cols = Math.ceil(Math.sqrt(N * (W / H)));
    const cellW = W / (cols + 1);
    const rows = Math.ceil(N / cols);
    const cellH = H / (rows + 1);
    nodes.forEach((n, i) => {
      const col = i % cols;
      const row = Math.floor(i / cols);
      n._x = cellW * (col + 1);
      n._y = cellH * (row + 1);
      n._vx = 0;
      n._vy = 0;
      nodeMap[n.id] = n;
    });
  } else {
    // Force layout: circular initial placement (prevents random clumping)
    nodes.forEach((n, i) => {
      const angle = (i / N) * Math.PI * 2;
      const radius = spread * (0.3 + 0.7 * Math.random());
      n._x = cx + Math.cos(angle) * radius;
      n._y = cy + Math.sin(angle) * radius;
      n._vx = 0;
      n._vy = 0;
      nodeMap[n.id] = n;
    });
  }

  // Resolve links and classify edge risk tier
  const resolvedLinks = links
    .map((l) => {
      const score = l.suspicious_score ?? (l.is_suspicious ? 1 : 0);
      let tier; // safe | normal | warning | suspicious
      if (score >= 0.7) tier = "suspicious";
      else if (score >= 0.3) tier = "warning";
      else if (score > 0) tier = "normal";
      else tier = "safe";
      return {
        source: nodeMap[l.source?.id ?? l.source] || nodeMap[l.from],
        target: nodeMap[l.target?.id ?? l.target] || nodeMap[l.to],
        amount: l.value || l.amount || l.total_amount || 0,
        is_suspicious: l.is_suspicious || false,
        suspicious_score: score,
        tier,
        tx_count: l.tx_count || 1,
      };
    })
    .filter((l) => l.source && l.target);

  // Create SVG groups
  const edgeGroup = document.createElementNS("http://www.w3.org/2000/svg", "g");
  const edgeAnnotGroup = document.createElementNS(
    "http://www.w3.org/2000/svg",
    "g",
  );
  const nodeGroup = document.createElementNS("http://www.w3.org/2000/svg", "g");
  const labelGroup = document.createElementNS(
    "http://www.w3.org/2000/svg",
    "g",
  );
  svg.appendChild(edgeGroup);
  svg.appendChild(edgeAnnotGroup);
  svg.appendChild(nodeGroup);
  svg.appendChild(labelGroup);

  // Edge mode
  const edgeMode =
    document.getElementById("graph-edge-mode")?.value || "suspicious";

  const lineEls = resolvedLinks.map((l) => {
    const line = document.createElementNS("http://www.w3.org/2000/svg", "line");
    line.classList.add("edge-" + l.tier);
    line.dataset.tier = l.tier;
    if (l.tier === "suspicious") {
      line.setAttribute("marker-end", "url(#arrow-sus)");
    } else if (l.tier === "warning") {
      line.setAttribute("marker-end", "url(#arrow-warn)");
    } else {
      line.setAttribute("marker-end", "url(#arrow)");
    }
    // Apply initial edge mode visibility
    if (edgeMode === "none") {
      line.style.display = "none";
    } else if (
      edgeMode === "suspicious" &&
      l.tier !== "suspicious" &&
      l.tier !== "warning"
    ) {
      line.style.display = "none";
    } else if (
      edgeMode === "safe" &&
      l.tier !== "safe" &&
      l.tier !== "normal"
    ) {
      line.style.display = "none";
    }
    edgeGroup.appendChild(line);

    // Edge tooltip on hover
    line.style.cursor = "pointer";
    line.addEventListener("mouseenter", () => {
      const tierLabel = l.tier.charAt(0).toUpperCase() + l.tier.slice(1);
      const tierColors = {
        safe: "#10b981",
        normal: "#94a3b8",
        warning: "#fbbf24",
        suspicious: "#ef4444",
      };
      tooltip.style.display = "block";
      tooltip.innerHTML =
        `<strong style="color:${tierColors[l.tier]}">${tierLabel}</strong><br>` +
        `${escapeHtml(l.source.id)} → ${escapeHtml(l.target.id)}<br>` +
        `Amount: ₹${fmt(l.amount)}<br>` +
        `Transactions: ${l.tx_count}<br>` +
        `Suspicious Score: ${(l.suspicious_score * 100).toFixed(0)}%`;
    });
    line.addEventListener("mousemove", (e) => {
      const cr = svg.getBoundingClientRect();
      tooltip.style.left = e.clientX - cr.left + 12 + "px";
      tooltip.style.top = e.clientY - cr.top - 10 + "px";
    });
    line.addEventListener("mouseleave", () => {
      tooltip.style.display = "none";
    });

    return line;
  });

  // Edge annotations (tier label + amount on each edge)
  const annotMode =
    document.getElementById("graph-annotations")?.value || "off";
  const showEdgeAnnot = annotMode === "edges" || annotMode === "all";
  const showRiskAnnot = annotMode === "risk" || annotMode === "all";
  const tierColors = {
    safe: "#10b981",
    normal: "#94a3b8",
    warning: "#fbbf24",
    suspicious: "#ef4444",
  };

  const edgeAnnotEls = showEdgeAnnot
    ? resolvedLinks.map((l) => {
        const g = document.createElementNS("http://www.w3.org/2000/svg", "g");
        g.classList.add("edge-annotation");
        // Tier badge
        const tierText = document.createElementNS(
          "http://www.w3.org/2000/svg",
          "text",
        );
        const tierLabel = l.tier.charAt(0).toUpperCase() + l.tier.slice(1);
        tierText.textContent = tierLabel + " · ₹" + fmt(l.amount);
        tierText.setAttribute("text-anchor", "middle");
        tierText.setAttribute("dy", "-4");
        tierText.setAttribute("fill", tierColors[l.tier]);
        tierText.classList.add("edge-annot-text");
        g.appendChild(tierText);
        // Score line
        const scoreText = document.createElementNS(
          "http://www.w3.org/2000/svg",
          "text",
        );
        scoreText.textContent =
          (l.suspicious_score * 100).toFixed(0) +
          "% sus · " +
          l.tx_count +
          " tx";
        scoreText.setAttribute("text-anchor", "middle");
        scoreText.setAttribute("dy", "8");
        scoreText.setAttribute("fill", "rgba(180,190,210,0.6)");
        scoreText.classList.add("edge-annot-sub");
        g.appendChild(scoreText);
        // Visibility based on edge filter
        if (edgeMode === "none") g.style.display = "none";
        else if (
          edgeMode === "suspicious" &&
          l.tier !== "suspicious" &&
          l.tier !== "warning"
        )
          g.style.display = "none";
        else if (
          edgeMode === "safe" &&
          l.tier !== "safe" &&
          l.tier !== "normal"
        )
          g.style.display = "none";
        edgeAnnotGroup.appendChild(g);
        return g;
      })
    : [];

  // Shared drag state
  let dragNode = null;
  function onDocMouseMove(e) {
    if (!dragNode) return;
    const cr = svg.getBoundingClientRect();
    const scaleX = W / cr.width;
    const scaleY = H / cr.height;
    dragNode._x = (e.clientX - cr.left) * scaleX;
    dragNode._y = (e.clientY - cr.top) * scaleY;
    dragNode._vx = 0;
    dragNode._vy = 0;
  }
  function onDocMouseUp() {
    dragNode = null;
  }
  document.addEventListener("mousemove", onDocMouseMove);
  document.addEventListener("mouseup", onDocMouseUp);
  _graphDragCleanup = () => {
    document.removeEventListener("mousemove", onDocMouseMove);
    document.removeEventListener("mouseup", onDocMouseUp);
  };

  const circleEls = nodes.map((n) => {
    const risk = n.risk ?? n.risk_score ?? 0;
    const r = nodeRadius(risk, N);
    const circle = document.createElementNS(
      "http://www.w3.org/2000/svg",
      "circle",
    );
    circle.setAttribute("r", r);
    circle.setAttribute("fill", nodeColor(risk));
    if (risk >= 75) circle.setAttribute("filter", "url(#glow)");
    if (n.id === centerId) {
      circle.style.stroke = "#6366f1";
      circle.style.strokeWidth = "3";
    }

    circle.addEventListener("mouseenter", () => {
      tooltip.style.display = "block";
      tooltip.innerHTML = `<strong>${escapeHtml(n.id)}</strong><br>Risk: ${risk.toFixed(1)}%<br>Type: ${escapeHtml(n.type || "account")}`;
    });
    circle.addEventListener("mousemove", (e) => {
      const cr = svg.getBoundingClientRect();
      tooltip.style.left = e.clientX - cr.left + 12 + "px";
      tooltip.style.top = e.clientY - cr.top - 10 + "px";
    });
    circle.addEventListener("mouseleave", () => {
      tooltip.style.display = "none";
    });
    circle.addEventListener("mousedown", (e) => {
      dragNode = n;
      e.preventDefault();
    });
    // Double click: load subgraph for this node
    circle.addEventListener("dblclick", () => {
      document.getElementById("graph-account-id").value = n.id;
      loadSubgraph();
    });

    nodeGroup.appendChild(circle);
    return circle;
  });

  const textEls =
    showLabels || showRiskAnnot
      ? nodes.map((n) => {
          const risk = n.risk ?? n.risk_score ?? 0;
          const text = document.createElementNS(
            "http://www.w3.org/2000/svg",
            "text",
          );
          if (showRiskAnnot) {
            text.textContent = n.id + " (" + risk.toFixed(0) + "%)";
            text.setAttribute("fill", nodeColor(risk));
          } else {
            text.textContent = n.id;
          }
          text.setAttribute("text-anchor", "middle");
          text.setAttribute("dy", "-12");
          labelGroup.appendChild(text);
          return text;
        })
      : [];

  // Zoom & pan
  let zoomLevel = 1,
    panX = 0,
    panY = 0;
  function applyTransform() {
    const t = `translate(${panX},${panY}) scale(${zoomLevel})`;
    edgeGroup.setAttribute("transform", t);
    edgeAnnotGroup.setAttribute("transform", t);
    nodeGroup.setAttribute("transform", t);
    labelGroup.setAttribute("transform", t);
  }
  svg.addEventListener("wheel", (e) => {
    e.preventDefault();
    const delta = e.deltaY > 0 ? 0.9 : 1.1;
    zoomLevel = Math.max(0.1, Math.min(8, zoomLevel * delta));
    applyTransform();
  });
  let panning = false,
    panStartX,
    panStartY;
  svg.addEventListener("mousedown", (e) => {
    if (e.target === svg) {
      panning = true;
      panStartX = e.clientX - panX;
      panStartY = e.clientY - panY;
    }
  });
  svg.addEventListener("mousemove", (e) => {
    if (!panning) return;
    panX = e.clientX - panStartX;
    panY = e.clientY - panStartY;
    applyTransform();
  });
  svg.addEventListener("mouseup", () => {
    panning = false;
  });
  svg.addEventListener("mouseleave", () => {
    panning = false;
  });

  // Expose zoom controls for external buttons
  _graphZoomFns = {
    zoom(factor) {
      zoomLevel = Math.max(0.1, Math.min(8, zoomLevel * factor));
      applyTransform();
    },
    reset() {
      zoomLevel = 1;
      panX = 0;
      panY = 0;
      applyTransform();
    },
  };

  // ── Auto-fit viewBox helper ──
  function fitViewBox() {
    let minX = Infinity,
      minY = Infinity,
      maxX = -Infinity,
      maxY = -Infinity;
    nodes.forEach((n) => {
      const r = nodeRadius(n.risk ?? n.risk_score ?? 0, N) + 5;
      if (n._x - r < minX) minX = n._x - r;
      if (n._y - r < minY) minY = n._y - r;
      if (n._x + r > maxX) maxX = n._x + r;
      if (n._y + r > maxY) maxY = n._y + r;
    });
    const pad = 40;
    const vw = maxX - minX + pad * 2;
    const vh = maxY - minY + pad * 2;
    svg.setAttribute("viewBox", `${minX - pad} ${minY - pad} ${vw} ${vh}`);
  }

  // ── Force simulation ──
  const sim = { stop: false };
  graphSim = sim;

  // For static layouts, place nodes and auto-fit
  if (layoutMode !== "force") {
    lineEls.forEach((el, i) => {
      el.setAttribute("x1", resolvedLinks[i].source._x);
      el.setAttribute("y1", resolvedLinks[i].source._y);
      el.setAttribute("x2", resolvedLinks[i].target._x);
      el.setAttribute("y2", resolvedLinks[i].target._y);
    });
    circleEls.forEach((el, i) => {
      el.setAttribute("cx", nodes[i]._x);
      el.setAttribute("cy", nodes[i]._y);
    });
    textEls.forEach((el, i) => {
      el.setAttribute("x", nodes[i]._x);
      el.setAttribute("y", nodes[i]._y);
    });
    edgeAnnotEls.forEach((el, i) => {
      const l = resolvedLinks[i];
      const mx = (l.source._x + l.target._x) / 2;
      const my = (l.source._y + l.target._y) / 2;
      el.setAttribute("transform", `translate(${mx},${my})`);
    });
    fitViewBox();
    return;
  }

  // Scale-aware repulsion: moderate per-pair force, spread via ideal distance
  const idealDist = 30 + Math.sqrt(N) * 12;
  const repulsionStrength = idealDist * idealDist * 0.8;
  const springK = 0.003;
  const decay = 0.996;
  const alpha0 = 0.5;
  let currentAlpha = alpha0;

  function tick() {
    if (sim.stop || currentAlpha < 0.001) return;
    currentAlpha *= decay;

    // Repulsion (Barnes-Hut grid for N>200, brute-force otherwise)
    if (N <= 200) {
      for (let i = 0; i < N; i++) {
        for (let j = i + 1; j < N; j++) {
          let dx = nodes[j]._x - nodes[i]._x;
          let dy = nodes[j]._y - nodes[i]._y;
          let d2 = dx * dx + dy * dy;
          let dist = Math.sqrt(d2) || 1;
          let force = (repulsionStrength / d2) * currentAlpha;
          let fx = (dx / dist) * force;
          let fy = (dy / dist) * force;
          nodes[i]._vx -= fx;
          nodes[i]._vy -= fy;
          nodes[j]._vx += fx;
          nodes[j]._vy += fy;
        }
      }
    } else {
      const cellSize = idealDist * 1.5;
      const grid = {};
      for (let i = 0; i < N; i++) {
        const gx = Math.floor(nodes[i]._x / cellSize);
        const gy = Math.floor(nodes[i]._y / cellSize);
        const key = gx + "," + gy;
        if (!grid[key]) grid[key] = { items: [], mx: 0, my: 0 };
        grid[key].items.push(i);
        grid[key].mx += nodes[i]._x;
        grid[key].my += nodes[i]._y;
      }
      // Finalize centroids
      for (const key in grid) {
        const c = grid[key];
        c.mx /= c.items.length;
        c.my /= c.items.length;
      }
      for (let i = 0; i < N; i++) {
        const gx = Math.floor(nodes[i]._x / cellSize);
        const gy = Math.floor(nodes[i]._y / cellSize);
        // Near-field: direct pairwise within ±1 cells
        for (let ox = -1; ox <= 1; ox++) {
          for (let oy = -1; oy <= 1; oy++) {
            const cell = grid[gx + ox + "," + (gy + oy)];
            if (!cell) continue;
            for (let k = 0; k < cell.items.length; k++) {
              const j = cell.items[k];
              if (j <= i) continue;
              let dx = nodes[j]._x - nodes[i]._x;
              let dy = nodes[j]._y - nodes[i]._y;
              let d2 = dx * dx + dy * dy;
              let dist = Math.sqrt(d2) || 1;
              let force = (repulsionStrength / d2) * currentAlpha;
              let fx = (dx / dist) * force;
              let fy = (dy / dist) * force;
              nodes[i]._vx -= fx;
              nodes[i]._vy -= fy;
              nodes[j]._vx += fx;
              nodes[j]._vy += fy;
            }
          }
        }
        // Far-field: treat distant cells as single body
        for (const key in grid) {
          const c = grid[key];
          const parts = key.split(",");
          const cgx = +parts[0],
            cgy = +parts[1];
          if (Math.abs(cgx - gx) <= 1 && Math.abs(cgy - gy) <= 1) continue;
          let dx = c.mx - nodes[i]._x;
          let dy = c.my - nodes[i]._y;
          let d2 = dx * dx + dy * dy;
          let dist = Math.sqrt(d2) || 1;
          let force =
            ((repulsionStrength * c.items.length) / d2) * currentAlpha;
          nodes[i]._vx -= (dx / dist) * force;
          nodes[i]._vy -= (dy / dist) * force;
        }
      }
    }

    // Spring attraction along edges
    resolvedLinks.forEach((l) => {
      let dx = l.target._x - l.source._x;
      let dy = l.target._y - l.source._y;
      let dist = Math.sqrt(dx * dx + dy * dy) || 1;
      let force = (dist - idealDist) * springK * currentAlpha;
      let fx = (dx / dist) * force;
      let fy = (dy / dist) * force;
      l.source._vx += fx;
      l.source._vy += fy;
      l.target._vx -= fx;
      l.target._vy -= fy;
    });

    // Gentle center gravity — keep centered, NO hard boundaries
    const gravity = 0.0008;
    nodes.forEach((n) => {
      n._vx += (cx - n._x) * gravity * currentAlpha;
      n._vy += (cy - n._y) * gravity * currentAlpha;
      n._vx *= 0.82;
      n._vy *= 0.82;
      n._x += n._vx;
      n._y += n._vy;
      // NO boundary clamping — let nodes spread freely
    });

    // DOM update
    lineEls.forEach((el, i) => {
      el.setAttribute("x1", resolvedLinks[i].source._x);
      el.setAttribute("y1", resolvedLinks[i].source._y);
      el.setAttribute("x2", resolvedLinks[i].target._x);
      el.setAttribute("y2", resolvedLinks[i].target._y);
    });
    circleEls.forEach((el, i) => {
      el.setAttribute("cx", nodes[i]._x);
      el.setAttribute("cy", nodes[i]._y);
    });
    textEls.forEach((el, i) => {
      el.setAttribute("x", nodes[i]._x);
      el.setAttribute("y", nodes[i]._y);
    });
    edgeAnnotEls.forEach((el, i) => {
      const l = resolvedLinks[i];
      const mx = (l.source._x + l.target._x) / 2;
      const my = (l.source._y + l.target._y) / 2;
      el.setAttribute("transform", `translate(${mx},${my})`);
    });

    // Auto-fit camera to node positions every frame
    fitViewBox();

    requestAnimationFrame(tick);
  }
  requestAnimationFrame(tick);
}

// ══════════════════════════════════════════════════════
//  ANALYTICS
// ══════════════════════════════════════════════════════
let riskDistChart = null,
  patternFreqChart = null,
  analyticsTrendChart = null;

async function loadAnalytics() {
  try {
    const d = await apiFetch("/analytics");

    // Risk distribution (doughnut)
    if (d.risk_distribution) {
      const labels = Object.keys(d.risk_distribution);
      const values = Object.values(d.risk_distribution);
      const colors = ["#10b981", "#eab308", "#f59e0b", "#ef4444"];
      const ctx = document.getElementById("riskDistChart").getContext("2d");
      if (riskDistChart) riskDistChart.destroy();
      riskDistChart = new Chart(ctx, {
        type: "doughnut",
        data: {
          labels,
          datasets: [{ data: values, backgroundColor: colors, borderWidth: 0 }],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              position: "bottom",
              labels: { color: "#8492a6", font: { size: 11 } },
            },
          },
        },
      });
    }

    // Pattern frequency (bar)
    if (d.pattern_frequency) {
      const labels = Object.keys(d.pattern_frequency);
      const values = Object.values(d.pattern_frequency);
      const ctx = document.getElementById("patternFreqChart").getContext("2d");
      if (patternFreqChart) patternFreqChart.destroy();
      patternFreqChart = new Chart(ctx, {
        type: "bar",
        data: {
          labels,
          datasets: [
            {
              label: "Count",
              data: values,
              backgroundColor: "rgba(168,85,247,0.5)",
              borderColor: "#a855f7",
              borderWidth: 1,
              borderRadius: 6,
            },
          ],
        },
        options: chartOpts("Count"),
      });
    }

    // Transaction trends (line)
    if (d.transaction_trends) {
      const labels = Object.keys(d.transaction_trends);
      const values = Object.values(d.transaction_trends);
      const ctx = document
        .getElementById("analyticsTrendChart")
        .getContext("2d");
      if (analyticsTrendChart) analyticsTrendChart.destroy();
      analyticsTrendChart = new Chart(ctx, {
        type: "line",
        data: {
          labels,
          datasets: [
            {
              label: "Volume",
              data: values,
              borderColor: "#6366f1",
              backgroundColor: "rgba(99,102,241,0.1)",
              fill: true,
              tension: 0.4,
            },
          ],
        },
        options: chartOpts("Volume (₹)"),
      });
    }

    // Volume summary
    const volBox = document.getElementById("analytics-volume-summary");
    volBox.innerHTML = `
      <div class="info-grid">
        <div class="info-item"><span class="info-label">Total Volume</span><span class="info-value">₹${fmt(d.total_volume)}</span></div>
        <div class="info-item"><span class="info-label">Flagged Amount</span><span class="info-value" style="color:var(--red)">₹${fmt(d.flagged_amount)}</span></div>
      </div>`;

    // Flagged breakdown
    const flagBox = document.getElementById("analytics-flagged-summary");
    const pct = d.total_volume
      ? ((d.flagged_amount / d.total_volume) * 100).toFixed(1)
      : 0;
    flagBox.innerHTML = `
      <div style="text-align:center;padding:1rem 0">
        <div style="font-size:2.5rem;font-weight:700;color:var(--red)">${pct}%</div>
        <div style="color:var(--text-muted);font-size:0.85rem;margin-top:0.25rem">of total volume flagged as suspicious</div>
        <div class="risk-meter" style="margin-top:1rem;max-width:300px;margin-inline:auto">
          <div class="risk-bar-bg" style="height:8px"><div class="risk-bar-fill" style="width:${pct}%;background:var(--red);height:100%"></div></div>
        </div>
      </div>`;
  } catch (e) {
    document.getElementById("analytics-volume-summary").innerHTML =
      `<p class="muted" style="color:var(--red)">Error: ${escapeHtml(e.message)}</p>`;
  }
}

// ══════════════════════════════════════════════════════
//  TIMELINE
// ══════════════════════════════════════════════════════
async function loadTimeline() {
  const id = document.getElementById("timeline-account-id").value.trim();
  if (!id) return;
  const box = document.getElementById("timeline-content");
  box.innerHTML = '<p class="muted">Loading…</p>';
  try {
    const data = await apiFetch("/timeline/" + encodeURIComponent(id));
    if (!data.length) {
      box.innerHTML =
        '<p class="muted">No transactions found for this account.</p>';
      return;
    }
    let html = '<div class="timeline">';
    data.forEach((e) => {
      const isSus = e.status === "suspicious" || e.status === "flagged";
      html += `
        <div class="timeline-item ${isSus ? "suspicious" : ""}">
          <div class="timeline-date">${escapeHtml(e.date || e.time || "")}</div>
          <div class="timeline-title">${escapeHtml(e.title || e.type || "Transaction")}</div>
          <div class="timeline-desc">
            ${escapeHtml(e.description || "")}
            ${e.amount ? ` — <span class="timeline-amount">₹${fmt(e.amount)}</span>` : ""}
          </div>
        </div>`;
    });
    html += "</div>";
    box.innerHTML = html;
  } catch (e) {
    box.innerHTML = `<p class="muted" style="color:var(--red)">Error: ${escapeHtml(e.message)}</p>`;
  }
}

// ══════════════════════════════════════════════════════
//  REPORTS
// ══════════════════════════════════════════════════════
async function generateReport() {
  const id = document.getElementById("report-account-id").value.trim();
  if (!id) return;
  const box = document.getElementById("report-result");
  box.innerHTML = '<p class="muted">Generating report…</p>';
  try {
    const d = await apiFetch("/reports/generate", {
      method: "POST",
      body: JSON.stringify({ account_id: id, include_graph: true }),
    });
    box.innerHTML = `<div class="detail-box">
      <strong>Report ID:</strong> ${escapeHtml(d.report_id)}<br>
      <strong>Account:</strong> ${escapeHtml(d.account_id)}<br>
      <strong>Risk Score:</strong> <span style="color:${riskColor(d.risk_score)}">${d.risk_score?.toFixed(1)}%</span><br>
      <strong>Status:</strong> ${risklevelBadge(d.status)}<br><br>
      <strong>Report:</strong><br>
      <pre style="white-space:pre-wrap;color:var(--text-muted);font-size:0.82rem;margin-top:0.5rem">${escapeHtml(d.report_text)}</pre>
    </div>`;
    loadReportsList();
  } catch (e) {
    box.innerHTML = `<p class="muted" style="color:var(--red)">Error: ${escapeHtml(e.message)}</p>`;
  }
}

async function loadReportsList() {
  const listBox = document.getElementById("reports-list");
  const statsBox = document.getElementById("report-stats");

  try {
    const [reports, stats] = await Promise.all([
      apiFetch("/reports/"),
      apiFetch("/reports/stats"),
    ]);

    // Stats
    statsBox.innerHTML = `
      <div class="info-grid">
        <div class="info-item"><span class="info-label">Verified Reports</span><span class="info-value">${stats.verified_reports}</span></div>
        <div class="info-item"><span class="info-label">Generated (30d)</span><span class="info-value">${stats.generated_30d}</span></div>
        <div class="info-item"><span class="info-label">Awaiting Review</span><span class="info-value">${stats.awaiting_review}</span></div>
      </div>`;

    // List
    if (!reports.length) {
      listBox.innerHTML = '<p class="muted">No reports generated yet.</p>';
      return;
    }
    let html = `<table><thead><tr><th>ID</th><th>Title</th><th>Type</th><th>Date</th><th>Status</th></tr></thead><tbody>`;
    reports.forEach((r) => {
      html += `<tr>
        <td>${escapeHtml(r.id)}</td>
        <td>${escapeHtml(r.title)}</td>
        <td>${escapeHtml(r.type)}</td>
        <td>${escapeHtml(r.date)}</td>
        <td>${risklevelBadge(r.status)}</td>
      </tr>`;
    });
    listBox.innerHTML = html + "</tbody></table>";
  } catch (e) {
    listBox.innerHTML = `<p class="muted" style="color:var(--red)">Error: ${escapeHtml(e.message)}</p>`;
  }
}

// ══════════════════════════════════════════════════════
//  MODEL INFO
// ══════════════════════════════════════════════════════
async function loadModelInfo() {
  try {
    const [model, metrics] = await Promise.all([
      apiFetch("/model/info"),
      apiFetch("/metrics"),
    ]);

    document.getElementById("model-info").innerHTML = `
      <div class="info-grid">
        <div class="info-item"><span class="info-label">Model Type</span><span class="info-value">${escapeHtml(model.model_type)}</span></div>
        <div class="info-item"><span class="info-label">Version</span><span class="info-value">${escapeHtml(model.version)}</span></div>
        <div class="info-item"><span class="info-label">Layers</span><span class="info-value">${model.num_layers}</span></div>
        <div class="info-item"><span class="info-label">Input Features</span><span class="info-value">${model.input_features}</span></div>
        <div class="info-item"><span class="info-label">Fraud Threshold</span><span class="info-value">${model.fraud_threshold}</span></div>
        <div class="info-item"><span class="info-label">Training Epochs</span><span class="info-value">${model.training_epochs}</span></div>
        <div class="info-item"><span class="info-label">Last Trained</span><span class="info-value">${escapeHtml(model.last_trained)}</span></div>
        <div class="info-item"><span class="info-label">Accuracy</span><span class="info-value" style="color:var(--green)">${(model.accuracy * 100).toFixed(1)}%</span></div>
        <div class="info-item"><span class="info-label">Precision</span><span class="info-value">${(model.precision * 100).toFixed(1)}%</span></div>
        <div class="info-item"><span class="info-label">Recall</span><span class="info-value">${(model.recall * 100).toFixed(1)}%</span></div>
        <div class="info-item"><span class="info-label">F1 Score</span><span class="info-value">${(model.f1_score * 100).toFixed(1)}%</span></div>
      </div>`;

    document.getElementById("system-metrics").innerHTML = `
      <div class="info-grid">
        <div class="info-item"><span class="info-label">Transactions Processed</span><span class="info-value">${fmt(metrics.total_transactions_processed)}</span></div>
        <div class="info-item"><span class="info-label">Alerts Generated</span><span class="info-value">${fmt(metrics.total_alerts_generated)}</span></div>
        <div class="info-item"><span class="info-label">Avg Risk Score</span><span class="info-value">${metrics.average_risk_score?.toFixed(1)}%</span></div>
        <div class="info-item"><span class="info-label">Inference Latency</span><span class="info-value">${metrics.model_inference_latency_ms?.toFixed(1)} ms</span></div>
        <div class="info-item"><span class="info-label">Uptime</span><span class="info-value">${(metrics.uptime_seconds / 60).toFixed(0)} min</span></div>
      </div>`;
  } catch (e) {
    document.getElementById("model-info").innerHTML =
      `<p class="muted" style="color:var(--red)">Error: ${escapeHtml(e.message)}</p>`;
  }
}
