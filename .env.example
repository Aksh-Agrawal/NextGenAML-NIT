# ============================================================
#   NextGenAML – Environment Configuration Template
#   Copy this file to .env and fill in your values
# ============================================================

# --- Google Gemini API ---
GOOGLE_API_KEY=your_google_gemini_api_key_here
GROK_API_KEY=
VOICE_AUTH_LLM_PROVIDER=gemini

# --- Sarvam / Twilio Voice Authentication ---
VOICE_AUTH_ENABLED=true
VOICE_AUTH_MOCK_MODE=true
VOICE_AUTH_THRESHOLD=60
VOICE_AUTH_MANUAL_REVIEW_THRESHOLD=80
VOICE_AUTH_RETRY_SECONDS=300
VOICE_AUTH_LANGUAGE=hi-IN,en-IN
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_STT_MODEL=saaras:v2
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_PUBLIC_BASE_URL=https://your-public-api.example.com

# --- Memgraph ---
MEMGRAPH_HOST=127.0.0.1
MEMGRAPH_PORT=7687

# --- FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false
API_SECRET_TOKEN=changeme_in_production

# --- GNN Model ---
GNN_MODEL_TYPE=line_mvgnn        # line_mvgnn | graphsage | gat
GNN_FRAUD_THRESHOLD=0.75
GNN_FRAMEWORK=pyg

# --- Training ---
BATCH_SIZE=64
NUM_EPOCHS=50
LEARNING_RATE=0.001
NEIGHBORS_HOP1=20
NEIGHBORS_HOP2=10
NUM_WORKERS=4

# --- Streamlit ---
STREAMLIT_API_URL=http://localhost:8000
