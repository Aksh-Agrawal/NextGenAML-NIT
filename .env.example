# ============================================================
#   NextGenAML – Environment Configuration Template
#   Copy this file to .env and fill in your values
# ============================================================

# --- Google Gemini API ---
GOOGLE_API_KEY=your_google_gemini_api_key_here

# --- Memgraph ---
MEMGRAPH_HOST=127.0.0.1
MEMGRAPH_PORT=7687

# --- FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false
API_SECRET_TOKEN=changeme_in_production

# --- GNN Model ---
GNN_MODEL_TYPE=line_mvgnn        # line_mvgnn | graphsage | gat
GNN_FRAUD_THRESHOLD=0.75
GNN_FRAMEWORK=pyg

# --- Training ---
BATCH_SIZE=64
NUM_EPOCHS=50
LEARNING_RATE=0.001
NEIGHBORS_HOP1=20
NEIGHBORS_HOP2=10
NUM_WORKERS=4

# --- Streamlit ---
STREAMLIT_API_URL=http://localhost:8000
