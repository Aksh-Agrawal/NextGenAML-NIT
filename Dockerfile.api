FROM python:3.11-slim

WORKDIR /app

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ curl && rm -rf /var/lib/apt/lists/*

# Copy requirements first (layer caching)
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir fastapi uvicorn pydantic loguru \
    requests python-dotenv prometheus-client \
    numpy pandas scikit-learn networkx neo4j httpx python-multipart

# Copy source code
COPY api/ ./api/
COPY graph_db/ ./graph_db/
COPY ml/ ./ml/
COPY ingestion/ ./ingestion/
COPY training/ ./training/
COPY transaction.csv .
COPY .env* ./

EXPOSE 8089

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8089", "--log-level", "info"]
